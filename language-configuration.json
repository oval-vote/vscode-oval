{
  "comments": {
    "lineComment": "#"
  },
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["string", "comment"]
    }
  ],
  "surroundingPairs": [["\"", "\""]],
  "wordPattern": "@?[A-Za-z][A-Za-z0-9_-]*",
  "indentationRules": {
    "increaseIndentPattern": "^[ ]*(?:(?:ballot|section|contest|campaign|measure|party|candidate)(?:[ ]+.*)?|recommend[ ]*(?:#.*)?|(?:[^#\"]|\"(?:[^\"\\\\]|\\\\.)*\")*:[ ]*(?:#.*)?)$",
    "decreaseIndentPattern": "^(?!)"
  }
}
