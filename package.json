{
  "name": "oval",
  "displayName": "Oval",
  "publisher": "oval-vote",
  "description": "Language support for Oval voting guides",
  "version": "0.1.2",
  "license": "MIT",
  "repository": "github:oval-vote/vscode-oval",
  "homepage": "https://oval.vote",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:oval"
  ],
  "contributes": {
    "languages": [
      {
        "id": "oval",
        "aliases": [
          "Oval",
          "oval"
        ],
        "extensions": [
          ".oval"
        ],
        "mimetypes": [
          "text/prs.oval"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oval",
        "scopeName": "source.oval",
        "path": "./syntaxes/oval.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[oval]": {
        "editor.defaultFormatter": "oval-vote.oval"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "compile": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "vsce package --no-dependencies",
    "test": "npm run test:grammar && npm run test:unit",
    "test:grammar": "vscode-tmgrammar-test \"tests/unit/*.oval\"",
    "test:unit": "tsc -p . && node --test out/tests/unit/*.test.js",
    "test:integration": "tsc -p . && npm run build && vscode-test",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@oval-vote/oval": "0.1.3"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.104.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
