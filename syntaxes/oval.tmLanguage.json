{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Oval",
  "scopeName": "source.oval",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#markdown-field"
    },
    {
      "include": "#url"
    },
    {
      "include": "#string"
    },
    {
      "include": "#identifier"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#unknown-word"
    },
    {
      "include": "#tab"
    },
    {
      "include": "#character"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.oval"
    },
    "markdown-field": {
      "begin": "^([ ]*)((?:[^#\"]|\"(?:[^\"\\\\]|\\\\.)*\")*?)(:)[ ]*(#.*)?$",
      "beginCaptures": {
        "2": {
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        "3": {
          "name": "punctuation.separator.key-value.oval"
        },
        "4": {
          "name": "comment.line.number-sign.oval"
        }
      },
      "while": "^(?:[ ]*$|(?=\\1[ ]+\\S))",
      "contentName": "markup.other.markdown.oval",
      "patterns": [
        {
          "include": "#markdown"
        }
      ]
    },
    "markdown": {
      "patterns": [
        {
          "match": "^[ ]*(#{1,6})[ ]+.*$",
          "name": "markup.heading.oval",
          "captures": {
            "1": {
              "name": "punctuation.definition.heading.oval"
            }
          }
        },
        {
          "match": "\\*\\*[^*\\n]+\\*\\*",
          "name": "markup.bold.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_*])\\*[^*\\n]+\\*(?![A-Za-z0-9_*])",
          "name": "markup.italic.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_])_[^_\\n]+_(?![A-Za-z0-9_])",
          "name": "markup.italic.oval"
        },
        {
          "match": "`[^`\\n]+`",
          "name": "markup.inline.raw.oval"
        },
        {
          "match": "(\\[)([^\\]\\n]+)(\\])(\\()([^)\\n]+)(\\))",
          "captures": {
            "1": {
              "name": "punctuation.definition.link.oval"
            },
            "2": {
              "name": "string.other.link.title.oval"
            },
            "3": {
              "name": "punctuation.definition.link.oval"
            },
            "4": {
              "name": "punctuation.definition.link.oval"
            },
            "5": {
              "name": "markup.underline.link.oval"
            },
            "6": {
              "name": "punctuation.definition.link.oval"
            }
          }
        },
        {
          "match": "https?://[^ \\t\\r\\n]+",
          "name": "markup.underline.link.oval"
        }
      ]
    },
    "url": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_-])https?://[^ \\t\\r\\n]+",
          "name": "markup.underline.link.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_-])https?://",
          "name": "invalid.illegal.url.oval"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.oval",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.oval"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.oval"
        }
      },
      "patterns": [
        {
          "match": "\\\\[\"\\\\]",
          "name": "constant.character.escape.oval"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.oval"
        }
      ]
    },
    "identifier": {
      "patterns": [
        {
          "match": "(@)[ ]*([A-Za-z][A-Za-z0-9_-]*)(?=[ ]+\")",
          "name": "entity.name.type.declaration.oval",
          "captures": {
            "1": {
              "name": "punctuation.definition.identifier.oval"
            }
          }
        },
        {
          "match": "(@)[ ]*([A-Za-z][A-Za-z0-9_-]*)(?![A-Za-z0-9_-])",
          "name": "variable.other.reference.oval",
          "captures": {
            "1": {
              "name": "punctuation.definition.identifier.oval"
            }
          }
        },
        {
          "match": "@",
          "name": "punctuation.definition.identifier.oval"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_.-])\\d{4}-\\d{2}-\\d{2}(?![A-Za-z0-9_.-])",
          "name": "constant.numeric.date.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_.-])\\d+(?![A-Za-z0-9_.-])",
          "name": "constant.numeric.integer.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_.-])\\d[A-Za-z0-9_.-]*",
          "name": "invalid.illegal.number.oval"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_-])(?:oval)(?![A-Za-z0-9_-])",
          "name": "keyword.other.version.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_-])(?:party|candidate|ballot|section|contest|campaign|measure)(?![A-Za-z0-9_-])",
          "name": "storage.type.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_-])(?:guide|election|date|note|abbreviation|website|designation|eligibility|subtitle|tabulation|justification|description|if_yes|if_no|placement|fiscal_impact|supporters|opponents)(?![A-Za-z0-9_-])",
          "name": "support.type.property-name.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_-])(?:single|multiple|ranked|retention|max)(?![A-Za-z0-9_-])",
          "name": "keyword.other.method.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_-])(?:incumbent|withdrawn)(?![A-Za-z0-9_-])",
          "name": "storage.modifier.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_-])(?:as)(?![A-Za-z0-9_-])",
          "name": "keyword.other.as.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_-])(?:recommend|support|oppose)(?![A-Za-z0-9_-])",
          "name": "keyword.control.oval"
        },
        {
          "match": "(?<![A-Za-z0-9_-])(?:yes|no-position|no|none)(?![A-Za-z0-9_-])",
          "name": "constant.language.oval"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ":",
          "name": "punctuation.separator.key-value.oval"
        },
        {
          "match": ",",
          "name": "punctuation.separator.list.oval"
        }
      ]
    },
    "unknown-word": {
      "match": "(?<![A-Za-z0-9_@])[A-Za-z][A-Za-z0-9_-]*",
      "name": "invalid.illegal.unexpected-word.oval"
    },
    "tab": {
      "match": "\\t+",
      "name": "invalid.illegal.tab.oval"
    },
    "character": {
      "match": "[^ \\t\\r\\n\"#@:,A-Za-z0-9]",
      "name": "invalid.illegal.character.oval"
    }
  }
}
